{
  "opencollection": "1.0.0",
  "info": {
    "name": "YouScan Data Import Tags API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-KEY",
      "value": "{{X-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.youscan.io/api/external/topics/:topicId/tags",
            "params": [
              {
                "name": "topicId",
                "value": "",
                "type": "path",
                "description": "ID of the Topic."
              }
            ]
          },
          "docs": "Returns the collection of tags created in your topic."
        },
        {
          "info": {
            "name": "Create tag",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.youscan.io/api/external/topics/:topicId/tags",
            "params": [
              {
                "name": "topicId",
                "value": "",
                "type": "path",
                "description": "ID of the Topic."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new tag in the topic."
        }
      ]
    }
  ],
  "bundled": true
}