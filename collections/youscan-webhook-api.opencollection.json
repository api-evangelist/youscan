{
  "opencollection": "1.0.0",
  "info": {
    "name": "YouScan Data Import Webhook API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-KEY",
      "value": "{{X-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Webhook",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Mention found",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.youscan.io/api/external/your-webhook-endpoint",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Sent by YouScan to the URL you configured, every time a new mention is found and\nsaved to the topic. Fields with `null` values are omitted from the payload.\n"
        }
      ]
    }
  ],
  "bundled": true
}