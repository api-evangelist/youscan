{
  "opencollection": "1.0.0",
  "info": {
    "name": "YouScan Data Import Spaces API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-KEY",
      "value": "{{X-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Spaces",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List spaces",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.youscan.io/api/external/spaces"
          },
          "docs": "List spaces available to the authenticated user."
        },
        {
          "info": {
            "name": "List categories",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.youscan.io/api/external/spaces/:spaceId/categories",
            "params": [
              {
                "name": "spaceId",
                "value": "",
                "type": "path",
                "description": "ID of the Space."
              }
            ]
          },
          "docs": "List categories configured in the specified space."
        }
      ]
    }
  ],
  "bundled": true
}